# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to 1 (or the number of proxies) when running behind Render, Railway, Nginx…
TRUST_PROXY=false

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Public URL of the portfolio site. Used for links in notification emails.
SITE_URL=http://localhost:5173

# -------------------------------------------------------------- database
# Matches docker-compose.yml. Neon/Supabase URLs with ?sslmode=require work too.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio

# ------------------------------------------------------------------ auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# The refresh token travels in an httpOnly cookie.
# Same-site deploys (site proxies /api to this server): lax.
# Frontend and API on different sites: none (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# First administrator, created by `npm run db:seed`. The seed never overwrites
# the password of an account that already exists.
ADMIN_NAME=Izzul Faturrizky
ADMIN_EMAIL=izzulfaturrizky@gmail.com
ADMIN_PASSWORD=change-me-to-something-long

# ----------------------------------------------------------------- media
# Images and documents are stored in the FRONTEND repository (public/media) and
# served by the site's host (e.g. Vercel). This API never stores or serves files.
#
#   auto        github if GITHUB_TOKEN and GITHUB_REPO are set; otherwise filesystem
#               when MEDIA_DIR exists (local development); otherwise readonly
#   filesystem  write into a local checkout of the frontend
#   github      commit uploads to the frontend repository; the host redeploys
#   readonly    no uploads: add files to public/media by hand and redeploy
MEDIA_DRIVER=auto
MEDIA_DIR=../portfolio-frontend/public/media
MEDIA_PUBLIC_PATH=/media
MAX_UPLOAD_MB=10

# GitHub storage: a fine-grained token limited to the frontend repository, with
# the "Contents: Read and write" permission.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_MEDIA_PATH=public/media

# --------------------------------------------- contact form notifications
# Optional. Leave SMTP_HOST empty to only store messages in the CMS inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
